PORT=3001

# MySQL 설정 (MySQL Workbench에서 확인)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=maple_defense

# JWT 시크릿 (랜덤 문자열로 변경하세요)
JWT_SECRET=maple_defense_jwt_secret_change_this

# 클라이언트 주소 (CORS 허용)
CLIENT_URL=http://localhost:5173
